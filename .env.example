ENV=local

API_TITLE=Papperless Leads API
API_VERSION=0.1.0
# local dev: http://localhost:3000 ; prod: https://<your-domain>
FRONT_URL=http://localhost:3000

# Prod only (docker-compose.prod.yml + Caddy). Your public hostname, e.g. a
# free DuckDNS name. Caddy issues the TLS cert for it automatically.
# SITE_DOMAIN=papperless-leads.duckdns.org

# Medallion lake root.
#   Local dev:   ./_lake
#   Wasabi (S3): s3://papperlesspreprod-leads-lake   <-- required for ingestion
LAKE_ROOT=./_lake
GOLD_LEADS_PATH=gold/leads_scored
GOLD_KPI_PREFIX=gold
BRONZE_PREFIX=bronze

# Only used when LAKE_ROOT starts with s3://
S3_ENDPOINT_URL=https://s3.eu-west-2.wasabisys.com
S3_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# INSEE API Sirene 3.11 key (portail-api.insee.fr). Only for ad-hoc lookups,
# NOT used by the bulk ingestion job. Keep the real value in .env only.
# INSEE_API_KEY=

# France Travail (offres d'emploi). Needed by the france_travail DAG / poller.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Kafka. Host poller uses localhost:29092 ; jobs inside the compose use kafka:9092.
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_TOPIC_FT=france_travail.offres

# One domain, auto HTTPS. API paths -> FastAPI, everything else -> Next.
# SITE_DOMAIN is read from the environment (see docker-compose.prod.yml / .env).

{$SITE_DOMAIN} {
	encode zstd gzip

	# FastAPI routes (no /api prefix in the app)
	@api path /health /leads /leads/* /kpis /kpis/* /map/* /firms/* /signaux-du-jour
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy front:3000
	}
}
